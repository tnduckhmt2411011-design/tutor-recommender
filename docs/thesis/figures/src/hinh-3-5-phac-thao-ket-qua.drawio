        <!-- Khung giải thích quy tắc CN03 trong rail phải -->
        <mxCell id="rail_note" value="&lt;b&gt;Quy ước tương tác &amp;amp; trọng số (Bảng 3.5):&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Bốn mức &lt;i&gt;Bỏ qua / Thấp / TB / Cao&lt;/i&gt; quy đổi lần lượt thành &lt;i&gt;w_i = 0, 1, 2, 3&lt;/i&gt;.&lt;br&gt;&lt;br&gt;- Khi người học đổi mức ưu tiên, giao diện tự gửi &lt;font face=&quot;Consolas&quot; style=&quot;font-size:11px&quot;&gt;POST /api/recommend&lt;/font&gt; và cập nhật xếp hạng ngay.&lt;br&gt;&lt;br&gt;- Nếu cả 5 tiêu chí ở &lt;i&gt;Bỏ qua (0)&lt;/i&gt;: tổng trọng số bằng 0 và chuyển sang trạng thái &lt;font face=&quot;Consolas&quot; style=&quot;font-size:11px&quot;&gt;zero_weight&lt;/font&gt;." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontFamily=Times New Roman;fontSize=12;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="914" y="502" width="402" height="148" as="geometry"/>
        </mxCell>

        <!-- HAI KHỐI TRẠNG THÁI BIÊN Ở ĐÁY MÀN HÌNH -->
        <mxCell id="edge_nomatch" value="&lt;b&gt;Trạng thái no_match&lt;/b&gt;&lt;br&gt;&lt;i&gt;“Không tìm thấy gia sư thỏa mãn điều kiện”&lt;/i&gt;&lt;br&gt;Hiển thị khi không còn ứng viên qua lọc điều kiện bắt buộc (biến thể 1) hoặc tất cả ứng viên đều chưa đạt ngưỡng dữ liệu tối thiểu theo Bảng 3.7 (biến thể 2)." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;dashed=1;dashPattern=5 4;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=14;fontFamily=Times New Roman;fontSize=13;fillColor=#FDF8F0;strokeColor=#9A6B2F;strokeWidth=1.5;fontColor=#8A4B08;" vertex="1" parent="1">
          <mxGeometry x="46" y="692" width="628" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="edge_zero" value="&lt;b&gt;Trạng thái zero_weight&lt;/b&gt;&lt;br&gt;&lt;i&gt;“Không thể xếp hạng do tổng trọng số bằng 0”&lt;/i&gt;&lt;br&gt;Hiển thị khi tổng trọng số các tiêu chí đang áp dụng bằng 0; liệt kê các ứng viên đạt điều kiện bắt buộc (&lt;font face=&quot;Consolas&quot; style=&quot;font-size:11.5px&quot;&gt;unranked_candidates&lt;/font&gt;) và gợi ý chọn lại ít nhất một mức ưu tiên." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;dashed=1;dashPattern=5 4;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=14;fontFamily=Times New Roman;fontSize=13;fillColor=#FDF8F0;strokeColor=#9A6B2F;strokeWidth=1.5;fontColor=#8A4B08;" vertex="1" parent="1">
          <mxGeometry x="708" y="692" width="628" height="118" as="geometry"/>
        </mxCell>

        <!-- Ghi chú đáy giống Hình 3.4 -->
        <mxCell id="footer_note" value="&lt;i&gt;Ghi chú: số liệu trong bản phác thảo được tính đúng theo công thức (2.1) và Bảng 3.5–3.6 (w_i = 2, |L| = 4 buổi), không phải kết quả thực nghiệm (xem Chương 5); giao diện hiện thực thuộc Hình 4.2–4.4.&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=13;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="20" y="854" width="1340" height="36" as="geometry"/>
        </mxCell>

